# .env.example  →  복사해서 .env 로 쓰세요:  copy .env.example .env
# .env 는 절대 git 에 올라가지 않습니다 (.gitignore 등록됨).
#
# ★ 도쿄 VPS 로 옮길 때 바꿀 값은 이 파일 안에만 있습니다.
#   코드는 한 줄도 고치지 않습니다.

# ── 데이터베이스 ────────────────────────────────────────────
POSTGRES_USER=th
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=trading_helper
POSTGRES_PORT=5432

TH_DB_HOST=localhost        # VPS 컨테이너 안에서는 db 로 덮어써짐
TH_DB_PORT=5432

# ── Redis ──────────────────────────────────────────────────
REDIS_PORT=6379
TH_REDIS_HOST=localhost
TH_REDIS_PORT=6379

# ── 수집 대상 ───────────────────────────────────────────────
# 쉼표로 구분. 주력 심볼을 맨 앞에 둡니다.
# 처음에는 SOXLUSDT 하나로 시작하세요. 심볼을 늘리면 WebSocket 스트림도
# 심볼당 4개씩 늘어납니다. 추가하기 전에 `th doctor` 로 해당 심볼이 바이낸스에
# 실제로 있는지 먼저 확인하세요 (주식 perp 은 심볼명이 상장마다 다릅니다).
TH_SYMBOLS=SOXLUSDT
# 예) TH_SYMBOLS=SOXLUSDT,NVDAUSDT,TSLAUSDT

# 본주 괴리(basis) 계산용 매핑  perp:ticker
TH_UNDERLYING_MAP=SOXLUSDT:SOXL
# 참고 지수 (변동성/시장 필터용)
TH_REFERENCE_TICKERS=SOXX,^VIX,SPY

# ── 바이낸스 API ────────────────────────────────────────────
# Phase 0~1.5 는 시세만 읽으므로 키가 없어도 동작합니다.
#
# ★ Phase 2 부터 계정 조회에 필요합니다. 키를 만들 때:
#   · "Enable Reading" 만 체크          ← 이것만!
#   · "Enable Futures" 는 조회에도 필요할 수 있습니다 (거래 권한과는 별개)
#   · 출금(Withdraw)·거래(Trading) 권한은 절대 주지 마세요
#   · VPS 로 옮긴 뒤에는 IP 화이트리스트를 반드시 겁니다
#
# 이 값은 서버 밖으로 나가지 않습니다. 화면에도, DB에도 저장하지 않습니다.
TH_BINANCE_API_KEY=
TH_BINANCE_API_SECRET=
TH_BINANCE_FAPI_BASE=https://fapi.binance.com
TH_BINANCE_WS_BASE=wss://fstream.binance.com

# ── 캘린더 이벤트 자동 수집 (Phase 1.5) ──────────────────────
# FRED 무료 API 키 — 경제지표(CPI·고용·PCE 등) 발표 일정을 자동으로 받아옵니다.
# 발급: https://fred.stlouisfed.org/docs/api/api_key.html  (이메일만 있으면 무료·즉시)
# 비워두면 경제지표 수집만 건너뛰고 실적일 수집은 그대로 동작합니다.
TH_FRED_API_KEY=

# 실적일을 추적할 종목 (SOXX 상위 구성종목)
TH_EARNINGS_SYMBOLS=NVDA,AVGO,AMD,TSM,INTC,QCOM,TXN,MU,LRCX,AMAT

# 앞으로 며칠치 일정을 받아올지
TH_CALENDAR_SYNC_DAYS=90

# ── 리스크 (Phase 2) ────────────────────────────────────────
# 한 번 매매에 계좌의 몇 %를 걸 것인가. 이게 1R 의 정의입니다.
# 일일 손실 한도 −3R 은 "이 금액의 3배를 잃으면 그날 종료"라는 뜻입니다.
# 10배 데이트레이딩에서는 1%도 공격적입니다.
TH_RISK_PCT=0.5

# ── 실행 모드 (자동매매 확장점) ──────────────────────────────
# none  : 주문 기능 자체가 꺼짐  ← 지금은 반드시 none
# paper : 가상 체결만 기록 (Phase 4 이후)
# live  : 실주문 (한참 뒤, 별도 승인 절차 필요)
TH_EXECUTION_MODE=none

# ── 기타 ────────────────────────────────────────────────────
TH_LOG_LEVEL=INFO
TH_ENV=local                # local | vps | prod
# 멀티유저 전환 전까지 모든 데이터가 이 소유자에게 귀속됩니다
TH_OWNER_ID=00000000-0000-0000-0000-000000000001

# ── 뉴스·이벤트 매매 엔진 (v3.0, docs/17) ────────────────────
# true 면 `th stream` 이 뉴스를 수집하고 `th serve` 가 엔진을 띄운다. 기본 false.
TH_NEWS_ENABLED=false
# observe : 수집·판단만 (주문 없음)
# paper   : 확신도가 임계값 이상이면 바로 페이퍼 주문   ← 기본
# approve : 텔레그램 승인 버튼을 누른 것만 페이퍼 주문 (실거래 흐름 리허설)
TH_NEWS_EXEC=paper
# Claude 판단 모델 (본판단 / 트리아지)
TH_NEWS_MODEL=claude-opus-5
TH_NEWS_TRIAGE_MODEL=claude-haiku-4-5
# 본판단 사고 깊이 low|medium|high. 비용의 대부분이 사고 토큰이라 medium 이면 절반, low 면 1/3 (PHASE9 §5)
TH_NEWS_EFFORT=high
# 켤 소스. 판단 건수(=비용)는 소스가 정한다. 시드가 작으면 telegram,edgar,yahoo 로 시작
TH_NEWS_SOURCES=telegram,edgar,yahoo,gnews,finnhub
ANTHROPIC_API_KEY=
# 매매로 가는 최소 확신도 (0~1)
TH_NEWS_MIN_CONFIDENCE=0.70
# 작전 하나의 마진 합계 (시드 %) · 배율 · 손절 범위(가격 %) · 최대 보유
TH_NEWS_MARGIN_PCT_MAX=10
TH_NEWS_LEVERAGE=10
TH_NEWS_STOP_MIN_PCT=1.0
TH_NEWS_STOP_MAX_PCT=5.0
TH_NEWS_MAX_HOLD_HOURS=168
# approve 모드에서 승인 없이 이 시간이 지나면 작전 만료 (분)
TH_NEWS_APPROVAL_TTL_MIN=30
# 하루 Claude API 비용 상한 (USD). 넘으면 판단을 멈추고 알린다 (수집은 계속)
TH_NEWS_DAILY_USD_CAP=5
# 뉴스 엔진을 쓰면 기존 가드의 동시 브래킷 수를 올려야 한다 (작전 3개 × 다리 3개). 실제 상한은 노출 3.0배·종목 1.0배가 막는다
# TH_MAX_OPEN_BRACKETS=9
# 텔레그램 — 구독 채널 읽기 (사용자 계정 세션). my.telegram.org 에서 발급 → `th news telegram-login` 1회
TH_TELEGRAM_API_ID=
TH_TELEGRAM_API_HASH=
TH_TELEGRAM_CHANNELS=
# 텔레그램 — 알림·승인 봇 (BotFather 에서 발급). chat_id 는 봇에게 아무 말이나 보낸 뒤 getUpdates 로 확인
TH_TELEGRAM_BOT_TOKEN=
TH_TELEGRAM_CHAT_ID=
# 선택: Finnhub company-news (무료 키)
TH_FINNHUB_API_KEY=
# SEC EDGAR 는 User-Agent 에 연락처를 요구한다. 예) "TradingHelper/0.1 (you@example.com)"
TH_EDGAR_USER_AGENT=
